// Showcase of every component, in every preset theme.
// Run with: cargo run -p themekit-gallery
//
// tests/gallery.rs fails if a component exported by the library is missing here.

import { Theme, ThemePresets, Label, Button, ButtonKind, Checkbox, Radio, Switch, Slider, NumberField, TextField, TooltipText, Select, Card, Badge, Chip, ProgressBar, Spinner, NavItem, Tab, TabBar, ListView, ListItem, TreeItem, Menu, MenuItem, Dialog, Popover, Alert, Toast, ToastStack, AccordionItem, Table, TableCell, TableCellKind, Divider, VerticalDivider, Splitter, ResizeGrip, ScrollArea, StateLayer, Shadow, Icons, Tone, TextRole, ControlSize } from "@themekit";

export component Gallery inherits Window {
    title: "slint-themekit gallery";
    background: Theme.palette.background;
    // The columns' width plus the room ScrollArea keeps for its scroll bar.
    preferred-width: columns.preferred-width + Theme.sizes.scrollbar-width + Theme.spacing.xs;
    preferred-height: Theme.sizes.control-height * 18;

    property <bool> checked: true;
    property <int> chip: 0;
    property <float> progress: 0.4;
    property <int> tab: 0;
    property <[string]> documents: ["Report.pdf", "Notes.txt", "Budget.xlsx", "Slides.key", "Photo.png"];
    property <[bool]> open: [true, true, true, true, true];
    property <int> document: 0;
    property <int> list-row: 2;
    property <int> list-opened: -1;
    property <string> menu-choice: "nothing yet";
    property <int> size: 1;
    property <bool> dialog-open;
    property <float> volume: 30;
    property <float> copies: 3;
    property <string> long-text: "A text too long for its field: cut off until you click it, then it scrolls with the cursor";
    // The tree demo: which folders are open, and the selected node.
    property <[bool]> folders-open: [true, false];
    property <int> tree-node: 1;
    // The panes demo: the left pane's width and the top pane's height.
    property <length> left-pane: Theme.sizes.control-height * 3;
    property <length> top-pane: Theme.sizes.control-height * 1.5;
    // The resize grip demo: the box's size.
    property <length> box-width: Theme.sizes.control-height * 6;
    property <length> box-height: Theme.sizes.control-height * 2;
    property <bool> notifications: true;
    // The closable alert, and which toasts are shown.
    property <bool> alert-open: true;
    property <[bool]> toasts: [false, false, false];
    // The popover's settings.
    property <bool> grid: true;
    property <float> zoom: 100;
    // The open accordion section, -1 for none.
    property <int> section: 0;
    // The table demo: its rows (icon, name, kind, size, copies, Open), the
    // selected one and the last opened one.
    property <TableCell> open-cell: { kind: TableCellKind.button, image: Icons.open, text: "Open" };
    property <[[TableCell]]> files: [
        [{ kind: TableCellKind.image, image: Icons.copy, colorize: Theme.palette.text-muted, text: "Document" }, { text: "Report.pdf" }, { text: "PDF document" }, { text: "1.2 MB" }, { kind: TableCellKind.number, value: 2, maximum: 10, step: 1 }, root.open-cell],
        [{ kind: TableCellKind.image, image: Icons.list, colorize: Theme.palette.text-muted, text: "Text" }, { text: "Notes.txt" }, { text: "Plain text" }, { text: "4 kB" }, { kind: TableCellKind.number, value: 1, maximum: 10, step: 1 }, root.open-cell],
        [{ kind: TableCellKind.image, image: Icons.chart, colorize: Theme.palette.text-muted, text: "Spreadsheet" }, { text: "Budget.xlsx" }, { text: "Spreadsheet" }, { text: "86 kB" }, { kind: TableCellKind.number, value: 3, maximum: 10, step: 1 }, root.open-cell],
        [{ kind: TableCellKind.image, image: Icons.play, colorize: Theme.palette.text-muted, text: "Presentation" }, { text: "Slides.key" }, { text: "Presentation" }, { text: "18.4 MB" }, { kind: TableCellKind.number, value: 1, maximum: 10, step: 1 }, root.open-cell],
        [{ kind: TableCellKind.image, image: Icons.inventory, colorize: Theme.palette.text-muted, text: "Archive" }, { text: "Archive with a name far too long for its column.zip" }, { text: "ZIP archive, split into three volumes" }, { text: "212 MB" }, { kind: TableCellKind.number, value: 0, maximum: 10, step: 1 }, root.open-cell],
        [{ kind: TableCellKind.image, image: Icons.copy, colorize: Theme.palette.text-muted, text: "Document" }, { text: "Invoice-0042.pdf" }, { text: "PDF document" }, { text: "96 kB" }, { kind: TableCellKind.number, value: 1, maximum: 10, step: 1 }, root.open-cell],
        [{ kind: TableCellKind.image, image: Icons.list, colorize: Theme.palette.text-muted, text: "Text" }, { text: "Draft.md" }, { text: "Markdown" }, { text: "12 kB" }, { kind: TableCellKind.number, value: 1, maximum: 10, step: 1 }, root.open-cell],
    ];
    property <int> file-row: 0;
    property <int> file-opened: -1;
    // The size of the table's number fields and buttons.
    property <ControlSize> file-size: ControlSize.medium;

    // Taller than most screens: the window opens at the columns' width and
    // a height that fits, and scrolls the rest.
    ScrollArea {
        columns := HorizontalLayout {
            padding: Theme.spacing.xl;
            spacing: Theme.spacing.lg;

            VerticalLayout {
                spacing: Theme.spacing.lg;
                alignment: start;

                Label { text: "slint-themekit"; role: TextRole.display; }
                Label { text: "Every pixel below comes from the active theme."; tone: Tone.muted; }

                HorizontalLayout {
                    spacing: Theme.spacing.sm;
                    alignment: start;
                    for theme in [ThemePresets.light, ThemePresets.dark, ThemePresets.sunset, ThemePresets.terminal]: Chip {
                        text: theme.name;
                        selected: Theme.current.name == theme.name;
                        clicked => { Theme.current = theme; }
                    }
                }

                Card {
                    Label { text: "Buttons"; role: TextRole.heading; }
                    HorizontalLayout {
                        spacing: Theme.spacing.sm;
                        alignment: start;
                        Button { text: "Primary"; icon: Icons.plus; }
                        Button { text: "Secondary"; kind: ButtonKind.secondary; }
                        Button { text: "Ghost"; kind: ButtonKind.ghost; }
                        Button { text: "Danger"; kind: ButtonKind.danger; }
                        Button { text: "Disabled"; enabled: false; }
                        Button {
                            icon: Icons.trash;
                            kind: ButtonKind.ghost;
                            accessible-label: "Delete";
                            // Hover it: icon-only buttons explain themselves.
                            Tooltip { TooltipText { text: "Delete"; } }
                        }
                    }
                    Divider { }
                    Label { text: "Inputs"; role: TextRole.heading; }
                    HorizontalLayout {
                        spacing: Theme.spacing.sm;
                        TextField { placeholder: "Type something…"; }
                        // Too long for the field: cut off, and whole in a tooltip.
                        long-field := TextField {
                            text <=> root.long-text;
                            if long-field.overflowing: Tooltip { TooltipText { text: root.long-text; } }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.spacing.sm;
                        Select {
                            options: ["Small", "Medium", "Large"];
                            current-index: root.size;
                            selected(index) => { root.size = index; }
                        }
                        Select {
                            options: ["Small", "Medium", "Large"];
                            placeholder: "Disabled, nothing picked";
                            enabled: false;
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.spacing.md;
                        Slider {
                            value: root.volume;
                            maximum: 100;
                            changed(value) => { root.volume = value; }
                        }
                        Label { text: "Volume \{root.volume}"; tone: Tone.muted; }
                        Slider { value: 60; enabled: false; }
                    }
                    HorizontalLayout {
                        spacing: Theme.spacing.md;
                        alignment: start;
                        NumberField {
                            width: Theme.sizes.control-height * 2.5;
                            value: root.copies;
                            maximum: 10;
                            changed(value) => { root.copies = value; }
                        }
                        Label { text: "Copies (0 to 10): drag sideways, or click and type"; tone: Tone.muted; }
                        NumberField {
                            width: Theme.sizes.control-height * 2.5;
                            value: 7;
                            enabled: false;
                        }
                    }
                    Checkbox {
                        text: "Controlled checkbox";
                        checked: root.checked;
                        toggled => { root.checked = !root.checked; }
                    }
                    HorizontalLayout {
                        spacing: Theme.spacing.lg;
                        alignment: start;
                        Switch {
                            text: "Notifications";
                            checked: root.notifications;
                            toggled => { root.notifications = !root.notifications; }
                        }
                        Switch { text: "Disabled"; checked: true; enabled: false; }
                    }
                    // The same choice as the first Select above.
                    HorizontalLayout {
                        spacing: Theme.spacing.lg;
                        alignment: start;
                        for label[index] in ["Small", "Medium", "Large"]: Radio {
                            text: label;
                            checked: root.size == index;
                            clicked => { root.size = index; }
                        }
                        Radio { text: "Disabled"; enabled: false; }
                    }
                    HorizontalLayout {
                        spacing: Theme.spacing.sm;
                        alignment: start;
                        for label[index] in ["Day", "Week", "Month"]: Chip {
                            text: label;
                            selected: root.chip == index;
                            clicked => { root.chip = index; }
                        }
                    }
                }

                Card {
                    Label { text: "Sizes"; role: TextRole.heading; }
                    Label {
                        text: "Buttons and fields come small, medium and large. Controls of a size are equally tall, so a row of them lines up.";
                        tone: Tone.muted;
                        wrap: word-wrap;
                    }
                    for row in [
                        { size: ControlSize.small, name: "Small" },
                        { size: ControlSize.medium, name: "Medium" },
                        { size: ControlSize.large, name: "Large" },
                    ]: HorizontalLayout {
                        spacing: Theme.spacing.sm;
                        Button { text: row.name; size: row.size; }
                        Button {
                            icon: Icons.plus;
                            kind: ButtonKind.secondary;
                            size: row.size;
                            accessible-label: "Add";
                        }
                        TextField { placeholder: row.name + " field"; size: row.size; }
                        Select {
                            options: ["Day", "Week", "Month"];
                            current-index: root.chip;
                            size: row.size;
                            selected(index) => { root.chip = index; }
                        }
                        NumberField {
                            width: Theme.control-height(row.size) * 2;
                            value: root.copies;
                            maximum: 10;
                            size: row.size;
                            changed(value) => { root.copies = value; }
                        }
                    }
                }

                Card {
                    Label { text: "Scrolling"; role: TextRole.heading; }
                    ScrollArea {
                        height: Theme.sizes.control-height * 4;
                        for index in 12: Label { text: "Row \{index + 1}"; }
                    }
                    Label { text: "Wider than the area, so it scrolls sideways too:"; tone: Tone.muted; }
                    ScrollArea {
                        height: Theme.sizes.control-height * 3;
                        for row in 6: HorizontalLayout {
                            spacing: Theme.spacing.md;
                            for column in 10: Label {
                                text: "R\{row + 1} C\{column + 1}";
                                width: Theme.sizes.control-height * 2;
                            }
                        }
                    }
                }

                Card {
                    Label { text: "Table"; role: TextRole.heading; }
                    Label {
                        text: "Columns with a width keep it, the others share the rest. Cells hold texts (hover a cut-off one to read it, a wrapping column grows its row), numbers to drag or type, images and buttons, in three sizes. Click a row to select it; double-click it or click Open to open it.";
                        tone: Tone.muted;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Theme.spacing.lg;
                        alignment: start;
                        for choice in [
                            { size: ControlSize.small, name: "Small" },
                            { size: ControlSize.medium, name: "Medium" },
                            { size: ControlSize.large, name: "Large" },
                        ]: Radio {
                            text: choice.name;
                            checked: root.file-size == choice.size;
                            clicked => { root.file-size = choice.size; }
                        }
                    }
                    Table {
                        height: Theme.sizes.control-height * 6;
                        columns: [
                            { width: Theme.sizes.icon },
                            { title: "Name" },
                            { title: "Kind", width: Theme.sizes.control-height * 3, wrap: true },
                            { title: "Size", width: Theme.sizes.control-height * 2, alignment: TextHorizontalAlignment.right },
                            { title: "Copies", width: Theme.sizes.control-height * 2 },
                            { width: Theme.control-height(root.file-size) },
                        ];
                        rows: root.files;
                        size: root.file-size;
                        selected-row: root.file-row;
                        row-clicked(row) => { root.file-row = row; }
                        row-double-clicked(row) => { root.file-opened = row; }
                        number-changed(row, column, value) => { root.files[row][column].value = value; }
                        button-clicked(row) => { root.file-opened = row; }
                    }
                    Label {
                        text: root.file-opened < 0 ? "Nothing opened yet." : "Opened " + root.files[root.file-opened][1].text + " (copies: \{root.files[root.file-opened][4].value}).";
                        tone: Tone.muted;
                    }
                }

                Card {
                    Label { text: "Building blocks"; role: TextRole.heading; }
                    Label {
                        text: "StateLayer gives your own components the library's hover and press feedback.";
                        tone: Tone.muted;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        min-height: Theme.sizes.control-height * 2;
                        border-radius: Theme.radii.md;
                        border-width: Theme.sizes.border-width;
                        border-color: Theme.palette.border;

                        StateLayer {
                            border-radius: parent.border-radius;
                            hovered: surface.has-hover;
                            pressed: surface.pressed;
                        }
                        Label { text: "Hover or press this surface"; horizontal-alignment: center; }
                        surface := TouchArea { mouse-cursor: pointer; }
                    }
                    Label {
                        text: "Shadow gives your own floating panels the dialogs' shadow.";
                        tone: Tone.muted;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: Theme.sizes.control-height * 2.5;
                        Shadow {
                            x: floating.x;
                            y: floating.y;
                            width: floating.width;
                            height: floating.height;
                            radius: floating.border-radius;
                        }
                        floating := Rectangle {
                            x: Theme.spacing.lg;
                            y: Theme.spacing.sm;
                            width: parent.width - Theme.spacing.lg * 2;
                            height: parent.height - Theme.spacing.lg * 2;
                            background: Theme.palette.surface;
                            border-radius: Theme.radii.lg;
                            border-width: Theme.sizes.border-width;
                            border-color: Theme.palette.border;
                            Label { text: "A floating panel"; horizontal-alignment: center; }
                        }
                    }
                    Label {
                        text: "Splitters resize the panes beside them: drag the bars.";
                        tone: Tone.muted;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        height: Theme.sizes.control-height * 4;
                        Rectangle {
                            width: root.left-pane;
                            background: Theme.palette.surface-variant;
                            Label { text: "Left"; horizontal-alignment: center; }
                        }
                        Splitter {
                            dragged(delta) => {
                                root.left-pane = clamp(root.left-pane + delta, Theme.sizes.control-height, Theme.sizes.control-height * 8);
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Rectangle {
                                height: root.top-pane;
                                Label { text: "Top"; horizontal-alignment: center; }
                            }
                            Splitter {
                                orientation: Orientation.vertical;
                                dragged(delta) => {
                                    root.top-pane = clamp(root.top-pane + delta, Theme.sizes.control-height / 2, Theme.sizes.control-height * 3);
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                background: Theme.palette.surface-variant;
                                Label { text: "Bottom"; horizontal-alignment: center; }
                            }
                        }
                    }
                    Label {
                        text: "A resize grip resizes the box it sits in: drag its corner.";
                        tone: Tone.muted;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            width: root.box-width;
                            height: root.box-height;
                            border-radius: Theme.radii.md;
                            border-width: Theme.sizes.border-width;
                            border-color: Theme.palette.border;
                            Label { text: "Resizable"; horizontal-alignment: center; }
                            ResizeGrip {
                                x: parent.width - self.width;
                                y: parent.height - self.height;
                                dragged(dx, dy) => {
                                    root.box-width = clamp(root.box-width + dx, Theme.sizes.control-height * 3, Theme.sizes.control-height * 12);
                                    root.box-height = clamp(root.box-height + dy, Theme.sizes.control-height, Theme.sizes.control-height * 4);
                                }
                            }
                        }
                    }
                }

                Card {
                    Label { text: "Icons"; role: TextRole.heading; }
                    Label {
                        text: "From Lucide. Drawn with colorize, so they take the color of their context.";
                        tone: Tone.muted;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Theme.spacing.lg;
                        alignment: start;
                        for icon in [Icons.plus, Icons.check, Icons.trash, Icons.list, Icons.chart, Icons.contrast, Icons.close, Icons.expand, Icons.collapsed, Icons.play, Icons.pause, Icons.stop, Icons.copy, Icons.open, Icons.save, Icons.inventory, Icons.magic, Icons.info, Icons.success, Icons.warning, Icons.danger]: Image {
                            source: icon;
                            colorize: Theme.palette.text;
                            width: Theme.sizes.icon * 1.5;
                            height: self.width;
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: Theme.spacing.lg;
                alignment: start;

                Card {
                    Label { text: "Feedback"; role: TextRole.heading; }
                    HorizontalLayout {
                        spacing: Theme.spacing.sm;
                        alignment: start;
                        Badge { text: "Neutral"; }
                        Badge { text: "Primary"; tone: Tone.primary; }
                        Badge { text: "Success"; tone: Tone.success; }
                        Badge { text: "Warning"; tone: Tone.warning; }
                        Badge { text: "Danger"; tone: Tone.danger; }
                    }
                    ProgressBar { value: root.progress; }
                    HorizontalLayout {
                        spacing: Theme.spacing.md;
                        alignment: start;
                        Spinner { }
                        Spinner { tone: Tone.success; }
                        Label { text: "Working…"; tone: Tone.muted; }
                    }
                    // A status bar: vertical dividers between its items.
                    HorizontalLayout {
                        spacing: Theme.spacing.sm;
                        alignment: start;
                        Label { text: "640 × 480 px"; tone: Tone.muted; }
                        VerticalDivider { }
                        Label { text: "12 kB"; tone: Tone.muted; }
                        VerticalDivider { }
                        Label { text: "Saved"; tone: Tone.success; }
                    }
                    Alert { title: "Heads up"; text: "An alert is about the content around it, in the tone of what it says."; }
                    Alert { tone: Tone.success; text: "Your changes were saved."; }
                    Alert { tone: Tone.warning; title: "Storage almost full"; text: "Free some space to keep saving files."; }
                    if root.alert-open: Alert {
                        tone: Tone.danger;
                        title: "Sync failed";
                        text: "Close this alert with its ×.";
                        closable: true;
                        close-label: "Dismiss";
                        close-requested => { root.alert-open = false; }
                    }
                    if !root.alert-open: Button {
                        text: "Show the closed alert again";
                        kind: ButtonKind.ghost;
                        clicked => { root.alert-open = true; }
                    }
                    HorizontalLayout {
                        spacing: Theme.spacing.sm;
                        alignment: start;
                        Button { text: "Less"; kind: ButtonKind.secondary; clicked => { root.progress = max(0, root.progress - 0.1); } }
                        Button { text: "More"; kind: ButtonKind.secondary; clicked => { root.progress = min(1, root.progress + 0.1); } }
                        Button { text: "Open dialog"; kind: ButtonKind.secondary; clicked => { root.dialog-open = true; } }
                        Button { text: "Show toasts"; kind: ButtonKind.secondary; clicked => { root.toasts = [true, true, true]; } }
                    }
                }

                Card {
                    Label { text: "Navigation"; role: TextRole.heading; }
                    NavItem { text: "Inbox"; icon: Icons.list; active: true; }
                    NavItem { text: "Reports"; icon: Icons.chart; }
                    NavItem { text: "Appearance"; icon: Icons.contrast; }
                }

                Card {
                    Label { text: "Tabs"; role: TextRole.heading; }
                    TabBar {
                        for label[index] in ["Overview", "Activity", "Settings"]: Tab {
                            text: label;
                            selected: root.tab == index;
                            clicked => { root.tab = index; }
                        }
                    }
                    Label { text: "Closable, wrapping when they don't fit:"; tone: Tone.muted; }
                    // One `if` per document: a closed tab must leave the layout,
                    // and Slint can't filter a model.
                    TabBar {
                        width: Theme.sizes.control-height * 8;
                        if root.open[0]: Tab { text: root.documents[0]; closable: true; close-label: "Close " + self.text; selected: root.document == 0; clicked => { root.document = 0; } close-requested => { root.open[0] = false; } }
                        if root.open[1]: Tab { text: root.documents[1]; closable: true; close-label: "Close " + self.text; selected: root.document == 1; clicked => { root.document = 1; } close-requested => { root.open[1] = false; } }
                        if root.open[2]: Tab { text: root.documents[2]; closable: true; close-label: "Close " + self.text; selected: root.document == 2; clicked => { root.document = 2; } close-requested => { root.open[2] = false; } }
                        if root.open[3]: Tab { text: root.documents[3]; closable: true; close-label: "Close " + self.text; selected: root.document == 3; clicked => { root.document = 3; } close-requested => { root.open[3] = false; } }
                        if root.open[4]: Tab { text: root.documents[4]; closable: true; close-label: "Close " + self.text; selected: root.document == 4; clicked => { root.document = 4; } close-requested => { root.open[4] = false; } }
                    }
                    Button {
                        text: "Reopen all";
                        kind: ButtonKind.ghost;
                        clicked => { root.open = [true, true, true, true, true]; }
                    }
                }

                Card {
                    Label { text: "Accordion"; role: TextRole.heading; }
                    // One section open at a time: opening one closes the others.
                    VerticalLayout {
                        AccordionItem {
                            title: "One open at a time";
                            expanded: root.section == 0;
                            toggled => { root.section = root.section == 0 ? -1 : 0; }
                            Label {
                                text: "The sections only report toggled(). The gallery keeps the open one's index, so opening a section closes the others.";
                                tone: Tone.muted;
                                wrap: word-wrap;
                            }
                        }
                        AccordionItem {
                            title: "Any content";
                            expanded: root.section == 1;
                            toggled => { root.section = root.section == 1 ? -1 : 1; }
                            Switch {
                                text: "Notifications";
                                checked: root.notifications;
                                toggled => { root.notifications = !root.notifications; }
                            }
                            Checkbox {
                                text: "Controlled checkbox";
                                checked: root.checked;
                                toggled => { root.checked = !root.checked; }
                            }
                        }
                        AccordionItem {
                            title: "Themed motion";
                            expanded: root.section == 2;
                            toggled => { root.section = root.section == 2 ? -1 : 2; }
                            Label {
                                text: "Sections unroll at the theme's fast motion; in Terminal, which has none, they open at once.";
                                tone: Tone.muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                Card {
                    Label { text: "Lists"; role: TextRole.heading; }
                    Label {
                        text: "A thousand items, of which only those in view exist. Click to select, double-click to open.";
                        tone: Tone.muted;
                        wrap: word-wrap;
                    }
                    ListView {
                        height: Theme.sizes.control-height * 5;
                        for index in 1000: ListItem {
                            index: index;
                            selected: root.list-row == index;
                            clicked => { root.list-row = index; }
                            double-clicked => { root.list-opened = index; }
                            Label { text: "Item \{index + 1}"; horizontal-stretch: 1; }
                            Label { text: Math.mod(index * 7, 100) + " kB"; tone: Tone.muted; }
                        }
                    }
                    Label {
                        text: root.list-opened < 0 ? "Nothing opened yet." : "Opened item \{root.list-opened + 1}.";
                        tone: Tone.muted;
                    }
                    Label { text: "Rows wider than the list scroll sideways, and the header follows:"; tone: Tone.muted; wrap: word-wrap; }
                    Rectangle {
                        clip: true;
                        height: wide-header.preferred-height;
                        wide-header := Label {
                            x: wide-list.content-x + Theme.spacing.md;
                            text: "Header: a line much longer than the list is wide, like the rows";
                            role: TextRole.caption;
                            tone: Tone.muted;
                        }
                    }
                    wide-list := ListView {
                        height: Theme.sizes.control-height * 3;
                        content-width: Theme.sizes.control-height * 16;
                        for index in 50: ListItem {
                            index: index;
                            width: wide-list.content-width;
                            Label { text: "Row \{index + 1}: a line much longer than the list is wide, like code"; }
                        }
                    }
                    Divider { }
                    Label { text: "A tree, as rows with a depth: click a chevron to open or close a folder."; tone: Tone.muted; wrap: word-wrap; }
                    VerticalLayout {
                        TreeItem {
                            text: "Documents";
                            expandable: true;
                            expanded: root.folders-open[0];
                            selected: root.tree-node == 0;
                            clicked => { root.tree-node = 0; }
                            toggled => { root.folders-open[0] = !root.folders-open[0]; }
                            Badge { text: "2"; }
                        }
                        if root.folders-open[0]: TreeItem {
                            text: "Report.pdf";
                            level: 1;
                            selected: root.tree-node == 1;
                            clicked => { root.tree-node = 1; }
                        }
                        if root.folders-open[0]: TreeItem {
                            text: "Notes.txt";
                            level: 1;
                            selected: root.tree-node == 2;
                            clicked => { root.tree-node = 2; }
                        }
                        TreeItem {
                            text: "Pictures";
                            expandable: true;
                            expanded: root.folders-open[1];
                            selected: root.tree-node == 3;
                            clicked => { root.tree-node = 3; }
                            toggled => { root.folders-open[1] = !root.folders-open[1]; }
                            Badge { text: "1"; }
                        }
                        if root.folders-open[1]: TreeItem {
                            text: "Photo.png";
                            level: 1;
                            selected: root.tree-node == 4;
                            clicked => { root.tree-node = 4; }
                        }
                    }
                    Divider { }
                    HorizontalLayout {
                        spacing: Theme.spacing.sm;
                        alignment: start;
                        open-menu := Button {
                            text: "Open menu";
                            kind: ButtonKind.secondary;
                            clicked => { menu.show(); }
                        }
                        open-popover := Button {
                            text: "Open popover";
                            kind: ButtonKind.secondary;
                            clicked => { popover.show(); }
                        }
                        Label { text: "Chosen: " + root.menu-choice; tone: Tone.muted; }
                    }
                }

                Card {
                    Label { text: "Typography"; role: TextRole.heading; }
                    Label { text: "Title"; role: TextRole.title; }
                    Label { text: "Heading"; role: TextRole.heading; }
                    Label { text: "Body text"; }
                    Label { text: "Caption"; role: TextRole.caption; tone: Tone.muted; }
                }
            }
        }
    }

    // Declared at the window's root, so `x` / `y` are window coordinates.
    menu := Menu {
        x: open-menu.absolute-position.x;
        y: open-menu.absolute-position.y + open-menu.height;
        MenuItem { text: "Duplicate"; clicked => { root.menu-choice = "Duplicate"; } }
        MenuItem { text: "Rename"; clicked => { root.menu-choice = "Rename"; } }
        MenuItem { text: "Archive (disabled)"; enabled: false; }
    }

    // Like the menu, at the button's window coordinates.
    popover := Popover {
        x: open-popover.absolute-position.x;
        y: open-popover.absolute-position.y + open-popover.height;
        width: Theme.sizes.control-height * 7;
        Label { text: "View"; role: TextRole.heading; }
        Switch {
            text: "Show grid";
            checked: root.grid;
            toggled => { root.grid = !root.grid; }
        }
        Label { text: "Zoom \{Math.round(root.zoom)} %"; tone: Tone.muted; }
        Slider {
            value: root.zoom;
            minimum: 50;
            maximum: 200;
            changed(value) => { root.zoom = value; }
        }
        Button { text: "Done"; clicked => { popover.close(); } }
    }

    if root.dialog-open: Dialog {
        width: root.width;
        height: root.height;
        title: "Delete Report.pdf?";
        Label {
            text: "The file is removed for good.";
            tone: Tone.muted;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Theme.spacing.sm;
            alignment: end;
            Button { text: "Cancel"; kind: ButtonKind.secondary; clicked => { root.dialog-open = false; } }
            Button { text: "Delete"; kind: ButtonKind.danger; clicked => { root.dialog-open = false; } }
        }
    }

    // Over everything else, sized like the window.
    ToastStack {
        width: root.width;
        height: root.height;
        if root.toasts[0]: Toast {
            tone: Tone.success;
            title: "Saved";
            text: "Report.pdf was saved. This toast closes by itself.";
            close-label: "Dismiss";
            close-requested => { root.toasts[0] = false; }
        }
        if root.toasts[1]: Toast {
            title: "Tip";
            text: "Keep the pointer over a toast to hold it open.";
            close-label: "Dismiss";
            close-requested => { root.toasts[1] = false; }
        }
        if root.toasts[2]: Toast {
            tone: Tone.danger;
            title: "Upload failed";
            text: "The server didn't answer. A persistent toast stays until you close it.";
            persistent: true;
            close-label: "Dismiss";
            close-requested => { root.toasts[2] = false; }
        }
    }
}
