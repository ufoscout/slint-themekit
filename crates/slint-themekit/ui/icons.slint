// Monochrome icons. Draw them with `colorize:` so they follow the palette.
export global Icons {
    out property <image> plus: @image-url("icons/plus.svg");
    out property <image> check: @image-url("icons/check.svg");
    out property <image> trash: @image-url("icons/trash.svg");
    out property <image> list: @image-url("icons/list.svg");
    out property <image> chart: @image-url("icons/chart.svg");
    out property <image> contrast: @image-url("icons/contrast.svg");
}
