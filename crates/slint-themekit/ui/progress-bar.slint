import { Theme } from "theme.slint";
import { Tone } from "tokens.slint";

// Horizontal bar showing `value` in the range 0..1.
export component ProgressBar inherits Rectangle {
    in property <float> value;
    in property <Tone> tone: Tone.primary;

    height: Theme.sizes.progress-height;
    border-radius: min(Theme.radii.full, self.height / 2);
    background: Theme.palette.surface-variant;
    accessible-role: progress-indicator;
    accessible-value: round(clamp(root.value, 0, 1) * 100) + "%";

    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        height: parent.height;
        border-radius: parent.border-radius;
        background: Theme.tone-color(root.tone);
        animate width { duration: Theme.motion.normal; easing: ease-out; }
    }
}
