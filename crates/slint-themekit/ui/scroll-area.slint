import { Theme } from "theme.slint";
import { ScrollIndicator } from "scroll-indicator.slint";

// Scrolling container with themed, draggable scroll indicators. Children are
// stacked in a VerticalLayout. It scrolls vertically, and sideways too when
// its content is wider than the area (wrapping text never is).
export component ScrollArea inherits Rectangle {
    in property <length> content-spacing: Theme.spacing.xs;

    property <length> track: Theme.sizes.scrollbar-width + Theme.spacing.xs;
    property <bool> wide: flick.content-width > flick.width;

    vertical-stretch: 1;
    horizontal-stretch: 1;

    flick := Flickable {
        x: 0;
        y: 0;
        width: root.width - root.track;
        height: root.height - (root.wide ? root.track : 0);

        VerticalLayout {
            spacing: root.content-spacing;
            alignment: start;
            @children
        }
    }

    if flick.content-height > flick.height: ScrollIndicator {
        x: root.width - self.width;
        width: Theme.sizes.scrollbar-width;
        height: flick.height;
        content-size: flick.content-height;
        visible-size: flick.height;
        offset <=> flick.content-y;
    }

    if root.wide: ScrollIndicator {
        orientation: Orientation.horizontal;
        y: root.height - self.height;
        width: flick.width;
        height: Theme.sizes.scrollbar-width;
        content-size: flick.content-width;
        visible-size: flick.width;
        offset <=> flick.content-x;
    }
}
